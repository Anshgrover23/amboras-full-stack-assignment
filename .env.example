# Backend (NestJS) — copy to backend/.env or set in shell
DATABASE_URL=postgresql://amboras:amboras@localhost:5432/amboras
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma-separated origins for browser clients
CORS_ORIGIN=http://localhost:3001
# Optional: enables ~45s Redis cache for GET /analytics/overview
REDIS_URL=redis://localhost:6379

# Seed script (bun run seed in /backend)
SEED_PASSWORD=demo1234
# Optional: more events for local perf testing (default 3500, max 200000)
# SEED_EVENT_COUNT=50000

# Frontend (Next.js) — copy to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3000
